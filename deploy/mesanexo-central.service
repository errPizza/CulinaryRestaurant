[Unit]
Description=Culinary Restaurant central multiempresa (no servidor de sucursal)
After=network.target
[Service]
Type=simple
User=mesanexo-central
Group=mesanexo-central
StateDirectory=mesanexo-central
StateDirectoryMode=0700
UMask=0077
ExecStart=/opt/mesanexo-central/MesaNexo.Central --central-id IDENTIDAD-CENTRAL
LoadCredential=central-data-key:/etc/mesanexo-central/secrets/data.key
LoadCredential=tls-key:/etc/mesanexo-central/secrets/tls.key
LoadCredential=tls-cert:/etc/mesanexo-central/secrets/tls.crt
LoadCredential=cloud-signing-key:/etc/mesanexo-central/secrets/cloud-signing.pem
ProtectSystem=strict
ProtectHome=yes
NoNewPrivileges=yes
PrivateTmp=yes
Restart=on-failure
[Install]
WantedBy=multi-user.target