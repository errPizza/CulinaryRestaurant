<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup><TargetFramework>net10.0</TargetFramework></PropertyGroup>
  <!-- The provider's root public key is compiled in: a key file on disk could be swapped for one that signs forged licenses.
       Release builds embed only the key passed as CulinaryRootPublicKey (tools/build.ps1); without it no license verifies. -->
  <PropertyGroup Condition="'$(CulinaryRootPublicKey)' == '' And '$(Configuration)' == 'Debug'"><CulinaryRootPublicKey>$(MSBuildThisFileDirectory)../../tests/keys/root-public.pem</CulinaryRootPublicKey></PropertyGroup>
  <ItemGroup><PackageReference Include="BouncyCastle.Cryptography" Version="2.7.0" /></ItemGroup>
  <ItemGroup Condition="'$(CulinaryRootPublicKey)' != ''"><EmbeddedResource Include="$(CulinaryRootPublicKey)" LogicalName="culinary-root-public.pem" /></ItemGroup>
</Project>
