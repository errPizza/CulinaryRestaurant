<Styles xmlns="https://github.com/avaloniaui" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" xmlns:local="clr-namespace:MesaNexo.Client">
 <Styles.Resources><Color x:Key="SystemAccentColor">#F2B93B</Color><Color x:Key="SystemAccentColorDark1">#BA810B</Color><Color x:Key="SystemAccentColorLight1">#FAC74E</Color>
  <ControlTheme x:Key="PrototypeButtonTheme" TargetType="Button">
   <Setter Property="FontSize" Value="13"/><Setter Property="FontWeight" Value="SemiBold"/><Setter Property="ClipToBounds" Value="False"/><Setter Property="VerticalContentAlignment" Value="Center"/>
   <Setter Property="Template"><ControlTemplate>
    <Border Name="PART_Border" Margin="3" MinHeight="{TemplateBinding MinHeight}" ClipToBounds="False" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="{TemplateBinding CornerRadius}" Padding="{TemplateBinding Padding}">
     <ContentPresenter Name="PART_ContentPresenter" Content="{TemplateBinding Content}" ContentTemplate="{TemplateBinding ContentTemplate}" FontFamily="{TemplateBinding FontFamily}" FontSize="{TemplateBinding FontSize}" FontWeight="{TemplateBinding FontWeight}" Foreground="{TemplateBinding Foreground}" HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}" RecognizesAccessKey="True"/>
    </Border>
   </ControlTemplate></Setter>
   <Style Selector="^:pointerover /template/ Border#PART_Border"><Setter Property="Background" Value="#EDF0F4"/></Style>
   <Style Selector="^.primary /template/ Border#PART_Border"><Setter Property="BoxShadow" Value="0 3 9 0 #26805810"/></Style>
   <Style Selector="^.primary:pointerover /template/ Border#PART_Border"><Setter Property="Background" Value="#FAC74E"/></Style>
   <Style Selector="^.nav:pointerover /template/ Border#PART_Border"><Setter Property="Background" Value="#28FFFFFF"/></Style>
   <Style Selector="^.primary.nav /template/ Border#PART_Border"><Setter Property="BoxShadow" Value="0 2 6 0 #26111924"/></Style>
   <Style Selector="^.primary.nav:pointerover /template/ Border#PART_Border"><Setter Property="Background" Value="#FAC74E"/></Style>
   <Style Selector="^:focus-visible /template/ Border#PART_Border"><Setter Property="BoxShadow" Value="0 0 0 3 #99F2B93B"/></Style>
   <Style Selector="^.nav /template/ Border#PART_Border"><Setter Property="Margin" Value="0"/></Style>
   <Style Selector="^.text /template/ Border#PART_Border"><Setter Property="Margin" Value="0"/></Style>
   <Style Selector="^:pressed /template/ Border#PART_Border"><Setter Property="Background" Value="#E2E6ED"/></Style>
   <Style Selector="^.primary:pressed /template/ Border#PART_Border"><Setter Property="Background" Value="#E4A72C"/></Style>
   <Style Selector="^:disabled"><Setter Property="Opacity" Value="0.5"/></Style>
  </ControlTheme>
 </Styles.Resources>
 <Style Selector="Button.prototype"><Setter Property="Theme" Value="{StaticResource PrototypeButtonTheme}"/></Style>
 <Style Selector="TextBlock"><Setter Property="FontFamily" Value="{x:Static local:Brand.InterfaceFont}"/></Style>
 <Style Selector=":is(TemplatedControl)"><Setter Property="FontFamily" Value="{x:Static local:Brand.InterfaceFont}"/></Style>
 <Style Selector="TextBox"><Setter Property="CornerRadius" Value="9"/><Setter Property="BorderBrush" Value="#CDD3DC"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#242E3B"/><Setter Property="FontSize" Value="14"/><Setter Property="Padding" Value="12,10"/></Style>
 <Style Selector="TextBox:focus /template/ Border#PART_BorderElement"><Setter Property="BorderBrush" Value="#A37413"/></Style>
 <Style Selector="ComboBox"><Setter Property="CornerRadius" Value="9"/><Setter Property="BorderBrush" Value="#CDD3DC"/><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#242E3B"/></Style>
 <Style Selector="CheckBox"><Setter Property="FontSize" Value="13"/></Style>
 <Style Selector="MenuItem"><Setter Property="FontSize" Value="12"/><Setter Property="MinHeight" Value="44"/><Setter Property="Padding" Value="12,9"/></Style>
</Styles>